<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local package sources.

  <clear /> drops any machine-wide sources inherited from the global NuGet.config so this
  solution restores identically on any machine — your box, a fresh clone, or CI. Without it,
  restore fails if a globally configured local source (e.g. a OneDrive folder) is missing.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
